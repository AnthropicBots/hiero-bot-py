# Required GitHub App Credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional AI review providers
# Only needed when ai_review.enabled = true.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=             # Optional key for OpenAI-compatible endpoints
OPENAI_BASE_URL=            # Optional endpoint: OpenAI, vLLM, LM Studio, a gateway, etc.
OLLAMA_BASE_URL=            # Optional Ollama endpoint, e.g. http://localhost:11434

# Optional: previous webhook secret accepted during zero-downtime rotation
GITHUB_WEBHOOK_SECRET_OLD=

# Database Connection (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./hiero_bot.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hiero_db

# Server Environment
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
ENVIRONMENT=development

# GitHub OAuth & Session Security
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET_KEY=dev-secret-key-32-bytes-minimum-length-change-in-prod
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Non-production defaults. Override via env (comma-separated or JSON list) in production.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Stripe Billing Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Webhook Skew Guard
WEBHOOK_MAX_SKEW_SECONDS=300

# Rate limiting (per process, per caller IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_BURST=0            # 0 = burst equals the per-minute budget

# Proxies in front of this app. 0 ignores X-Forwarded-For (a client can forge
# it); set to the number of trusted hops when running behind nginx/Cloudflare.
TRUSTED_PROXY_HOPS=0