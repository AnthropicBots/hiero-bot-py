#  Required
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

#  Optional 
ANTHROPIC_API_KEY=          # only needed for ai_review.enabled = true
OPENAI_API_KEY=             # OpenAI-compatible backend (takes precedence)
OPENAI_BASE_URL=            # any OpenAI-compatible endpoint: vLLM, LM Studio, a gateway
OLLAMA_BASE_URL=            # e.g. http://localhost:11434 — keeps code on your own machine
DATABASE_URL=sqlite+aiosqlite:///./hiero_bot.db
PORT=8000
LOG_LEVEL=info
ENVIRONMENT=development

#  Dashboard auth (leave blank to disable) 
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: max allowed webhook delivery age, in seconds
WEBHOOK_MAX_SKEW_SECONDS=300
