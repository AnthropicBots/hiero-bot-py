# Required GitHub App Credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Database Connection (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./hiero_bot.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hiero_db

# Server Environment
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
ENVIRONMENT=development

# GitHub OAuth & Session Security
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET_KEY=dev-secret-key-32-bytes-minimum-length-change-in-prod
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-32b-change-in-prod=

# Stripe Billing Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dashboard Basic Auth (Optional fallback)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# LLM Providers (Optional for AI PR review)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Webhook Skew Guard
WEBHOOK_MAX_SKEW_SECONDS=300

